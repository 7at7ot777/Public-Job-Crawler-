# Copy to .env and fill in. Nothing here reaches the network until
# CRAWLER_ENABLED and TELEGRAM_ENABLED are both true.

# --- Master switch ----------------------------------------------------------
CRAWLER_ENABLED=true

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, add it to your channel as an administrator,
# then set CHAT_ID to the channel id (e.g. -1001234567890) or @channelusername.
TELEGRAM_ENABLED=true
# Commands stay off: the heartbeat server's poller fights a second instance
# holding this token — getUpdates answers 409, "terminated by other getUpdates
# request" — and no user is allowed to issue commands anyway (0 allowed users).
# Sending is unaffected; only the polling stops.
TELEGRAM_COMMANDS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=15000
# Telegram allows roughly 20 messages/minute to one channel.
TELEGRAM_SEND_DELAY_MS=4000

# --- What to look for -------------------------------------------------------
# Comma-separated. Requests per run = keywords x locations x pages, so keep
# both lists short: every extra combination is another hit on a rate-limited
# public endpoint.
JOB_KEYWORDS=Laravel Developer,Node.js Developer,Backend Developer,PHP Developer,Full Stack Developer,Application Support,Application Developer
JOB_LOCATIONS=
# A quoted single space means no remote-only (f_WT=2) searches. It has to be
# quoted: dotenv trims an unquoted value, and an empty one restores the code
# default, Worldwide + EMEA.
JOB_REMOTE_LOCATIONS=" "
# Roles searched only as remote work, and only in the borderless markets
# (JOB_REMOTE_KEYWORD_LOCATIONS, default none: the search is Egypt only, so
# these are not searched until that is set, e.g. to Worldwide) — never in the local ones,
# where the search would return the on-site version of the same job. These
# carry f_WT=2, which JOB_REMOTE_LOCATIONS above does not switch off: it
# applies to the stack keywords only. One search per keyword per page.
JOB_REMOTE_KEYWORDS=Data Entry,Virtual Assistant,Technical Support,Data Annotation,Administrative Assistant,Content Moderator,Transcriptionist

# --- LinkedIn source --------------------------------------------------------
LINKEDIN_JOBS_ENABLED=true
# Own schedule in --watch: every 10 minutes. In the container the same rhythm
# comes from CRAWL_SOURCES=linkedin_jobs and CRAWL_INTERVAL_MINUTES=10. Egypt
# only, a pass is ~21 searches (~6 minutes), so 10 still leaves a pause between
# passes; crawling with no pause is what drew 429s.
LINKEDIN_JOBS_CRON=*/10 * * * *
# f_TPR value. r3600 = posted in the last hour: wider than the 10-minute
# schedule, so a slow or missed pass loses nothing; dedup drops repeats.
LINKEDIN_TIME_WINDOW=r3600
# One page per market, local and remote. A second page is mostly postings the
# ledger has already seen, and every market x keyword pair is another request
# against the rate limit that was answering 429.
LINKEDIN_MAX_PAGES=1
LINKEDIN_REMOTE_MAX_PAGES=1

# Location rotation: each run searches ONE location of JOB_LOCATIONS (with every
# keyword), the next run the next one. With the 6 default locations (Egypt,
# Cairo, Giza, Maadi, Heliopolis, Obour) and a 10-minute interval, every location
# is searched once an hour, and each run makes 7 searches instead of 42.
# JOB_LOCATIONS cannot hold "Cairo, Egypt" (it splits on commas): change the
# list in src/config.js. Adding locations makes the cycle longer, not any run
# heavier, so it does not bring the 429s back.
#
# Time window: a location is searched once per cycle, so LINKEDIN_TIME_WINDOW
# must reach back a whole cycle. You do NOT have to change it by hand: when
# there are more than 5 locations, the window is raised automatically to
# (locations + 1) x the interval, e.g. 6 locations -> r4200 (70 min),
# 10 -> r6600 (110 min). The value above stays the minimum. The window in use
# is logged as "LinkedIn location rotation".
#
# Trade-off: a new job can take up to one full cycle to arrive (30 min with 3
# locations, 1 h with 6, 2 h with 12).
#
# The rotation is skipped (every location searched) for --location / --keyword
# runs, the --watch startup pass and bot /jobs requests.
LINKEDIN_ROTATE_LOCATIONS=true
# Minutes between runs, which the window above is computed from. Empty uses
# CRAWL_INTERVAL_MINUTES (10 in the Dockerfile); set it to match
# LINKEDIN_JOBS_CRON when running --watch.
LINKEDIN_ROTATE_INTERVAL_MINUTES=


# --- HTTP behaviour ---------------------------------------------------------
HTTP_TIMEOUT_MS=15000
# Applied before every request, including the first.
#
# 12 a minute (5000 ms) answered 429 on a steady share of requests. This is
# 4 a minute — a third of it — which puts the container's LinkedIn pass near
# 6 minutes: 21 searches (7 keywords x Egypt, Cairo, Giza) plus the detail
# fetches, all at 15 seconds each.
REQUEST_DELAY_MS=15000
MAX_RETRIES=3
# Exponential: base * 2^(attempt-1) -> 4s, 8s, 16s
BACKOFF_BASE_MS=4000
USER_AGENT=

# --- Run limits -------------------------------------------------------------
MAX_ITEMS_PER_RUN=100
RETRY_AFTER_MINUTES=30
MAX_SEND_ATTEMPTS=5

# --- Schedule ---------------------------------------------------------------
# Standard 5-field cron. Used by `npm start` (--watch).
CRON_SCHEDULE=0 * * * *
TZ=Africa/Cairo

# --- Storage / logging ------------------------------------------------------
# ./data is where a mounted volume belongs, and pinning /tmp here defeated one:
# the store reads this value before anything probes the volume, so the database
# went to /tmp even on a host that had somewhere durable to put it. Left on the
# default, the store tries ./data first and falls back to /tmp by itself, with
# a warning, on a host where ./data turns out to be read-only.
DATABASE_PATH=./data/crawler.sqlite
LOG_LEVEL=info
LOG_FILE=./logs/crawler.log
# --- Filtering (applied to every source: jobs now, posts later) -------------
FILTER_ENABLED=true
# Item must contain at least one of these.
FILTER_TECH=laravel,node,nodejs,node.js,nestjs,php,backend,back-end,back end,support,data entry,virtual assistant,technical support,data annotation,data annotator,data labeling,data labelling,ai trainer,administrative assistant,admin assistant,content moderator,content moderation,transcription,transcriptionist,golang,go lang,go developer,go engineer,go programming,go language
# ...and at least one of these. Empty: the Egypt-only default in src/config.js
# (Egypt, Cairo, Giza, Alexandria and the Cairo districts, in English and Arabic).
FILTER_LOCATIONS=
# Remote only. LinkedIn already filters the remote markets server-side
# (f_WT=2); this drops anything else that does not say remote.
# false, and the container's masked ENV makes it false there too: with no
# f_WT=2 searches left, item.remote is never set, so remote-only would keep
# only the local-market postings whose own text says remote.
FILTER_REMOTE_ONLY=false
# Hiring posts only, never job-seeking ones. Applies to items of type 'post'
# and is inert for a job board's listing, which is an advertisement by
# definition. Decided on grammatical voice - an employer writes "we are
# looking for", a seeker writes "I am looking for" - plus an outright reject
# on the #OpenToWork and #OpenForWork hashtags.
FILTER_HIRING_ONLY=true
# true also drops a post whose snippet said neither way. Off by default: a
# snippet cut short mid-sentence is the usual cause, and the post behind it is
# often a real vacancy.
FILTER_HIRING_STRICT=false
# Wanted levels.
FILTER_SENIORITY_INCLUDE=junior,jr,mid,mid-level,midlevel,mid level,intermediate,entry level,entry-level
# Rejected outright, even if a wanted level also appears.
FILTER_SENIORITY_EXCLUDE=senior,sr,lead,principal,staff,staff engineer,founding,head of,director,manager,architect,vp,chief,expert
# false = keep items that never state a level. true = only explicit junior/mid.
FILTER_SENIORITY_STRICT=false
# The job title must name one of these. Empty disables the rule.
FILTER_TITLE=laravel,php,symfony,codeigniter,backend,back-end,back end,server side,server-side,node,nodejs,node.js,nestjs,express,expressjs,full stack,full-stack,fullstack,mern,mean stack,software engineer,software developer,web developer,web engineer,application developer,api developer,api engineer,application support,data entry,virtual assistant,technical support,data annotation,data annotator,data labeling,data labelling,ai trainer,administrative assistant,admin assistant,content moderator,content moderation,transcription,transcriptionist,golang,go developer,go engineer,go backend
# Title terms only wanted remote, whatever FILTER_REMOTE_ONLY says. The
# general roles above are searched Worldwide with f_WT=2, but the title terms
# are global: without this an on-site Content Moderator in Cairo passes every
# gate through a source that never asked for remote work. A stack role is
# exempt on purpose — an on-site Laravel job in Cairo is wanted.
FILTER_REMOTE_ONLY_TITLES=technical support,data annotation,data annotator,data labeling,data labelling,ai trainer,administrative assistant,admin assistant,content moderator,content moderation,transcription,transcriptionist
# Never wanted. Matched against the title and the posting's own location only.
FILTER_BLOCKED_LOCATIONS=india,bengaluru,bangalore,hyderabad,mumbai,pune,chennai,delhi,noida,gurugram,gurgaon,kolkata,pakistan,karachi,lahore,islamabad,rawalpindi,nigeria,lagos,abuja
# Rejected when the posting says any of these anywhere: residency, work
# authorisation, citizenship, clearance, nationality quotas, co-founder roles.
# Empty: the default list in src/config.js (the Android app's "Can't apply"
# list: Gulf residency/iqama/nationality phrases, in English and Arabic). A
# residency phrase followed by an Egyptian place ("must be based in Cairo")
# does not count.
FILTER_INELIGIBLE=
# Which types must carry an email or phone: posts | all | none
FILTER_REQUIRE_CONTACT=none

# LinkedIn server-side experience filter (f_E):
# 1 internship, 2 entry, 3 associate, 4 mid-senior, 5 director. Empty = off.
# Mid-senior is in: f_E is a comma list on the same request, so the level is
# free, and employers here routinely tag a two-to-four-year role as 4. This
# filter runs on LinkedIn's side, so anything it drops never reaches the
# crawler's own seniority rules — which read the title and decide, and already
# hand "Mid-Senior level" to the title rules rather than rejecting it
# (src/filters.js). Director is left out, being the level never a fit.
LINKEDIN_EXPERIENCE_LEVELS=2,3,4

# Window used only by the crawl that runs at startup. Wider than the hourly
# ticks so a restart or any downtime still catches recent jobs. Dedup keeps
# anything already delivered from being sent twice.
LINKEDIN_STARTUP_TIME_WINDOW=r86400

# --- LinkedIn posts source (hiring posts, via Serper) ------------------------
# Targets something different from the job sources on purpose: local hiring
# posts in Egypt, not remote work abroad. Own keywords, own locations, own
# schedule, own filters.
#
# Cost: per keyword x location x page, 1 run/day. Defaults are 5 keywords x
# 10 locations = 50 queries a day, ~1,500 Serper credits a month. Every extra
# keyword, location or page multiplies it.
#
# Off for now: this is the only source that spends Serper credits, and the
# engine has no "off" value (an empty LINKEDIN_POSTS_ENGINE throws), so pausing
# the source is how the credits stop. Flip back to true to resume; the key stays.
LINKEDIN_POSTS_ENABLED=true
LINKEDIN_POSTS_ENGINE=serper

SERPER_API_KEY=
# Google country code. This is what scopes results to Egypt; the location term
# in the query only biases them.
LINKEDIN_POSTS_COUNTRY=eg
LINKEDIN_POSTS_LANGUAGE=en

# Empty: the defaults in src/config.js decide (Laravel, Full Stack, Backend,
# Node.js, Software Engineer x Egypt and nine Greater Cairo areas).
LINKEDIN_POSTS_KEYWORDS=
LINKEDIN_POSTS_LOCATIONS=
# Daily at 07:00, read in TZ below (Africa/Cairo). Billed per query, so kept
# off the hourly CRON_SCHEDULE.
LINKEDIN_POSTS_CRON=0 7 * * *
# A week, not a day. Measured: Google's qdr:d filter returns ZERO results for
# this search - the niche is not indexed daily. The run is still daily; dedup
# is what makes the week-wide overlap free, so each run delivers only what was
# indexed since the last one.
LINKEDIN_POSTS_TIME_WINDOW=w
LINKEDIN_POSTS_STARTUP_TIME_WINDOW=w
# Freshness cut in days: read from the activity id in the permalink (the post's
# real write time), so it is exact. 3, because Serper reads Google's index and
# Google indexes a post 2-3 days late, so a 1-day cut on this route is empty.
LINKEDIN_POSTS_MAX_AGE_DAYS=3
# Each page is one billed query.
LINKEDIN_POSTS_MAX_PAGES=1
# Free: these requests go to LinkedIn, not to Serper.
LINKEDIN_POSTS_FETCH_DETAILS=true
LINKEDIN_POSTS_MAX_DETAILS=20
# Egypt is a local market, so an on-site hiring post is exactly what is wanted.
LINKEDIN_POSTS_REMOTE_ONLY=false
# Where the post must be, judged on the post's own words. Unlike the job
# boards, a search engine only biases towards a market - a search naming Egypt
# returns Jordan vacancies in first place - so this is not taken on trust.
# Empty: the default list in src/config.js, which knows the Greater Cairo areas.
LINKEDIN_POSTS_FILTER_LOCATIONS=
# Hiring-vs-seeking, for this source specifically. Its own variables, not the
# FILTER_HIRING_* pair: strict is ON here and off crawl-wide, and sharing one
# switch would let the global setting silently disable it.
#   HIRING_ONLY   - drop posts written by people looking for work
#   HIRING_STRICT - also drop posts that said neither way. On, because a
#                   "site:linkedin.com/posts laravel" search returns as much
#                   Laravel *content* as Laravel hiring, and all of it passes
#                   the tech filter.
LINKEDIN_POSTS_HIRING_ONLY=true
LINKEDIN_POSTS_HIRING_STRICT=true
# Markets that are not this one. A post naming no market is kept on the
# strength of the search; a post naming one of these is not.
LINKEDIN_POSTS_EXCLUDE_LOCATIONS=saudi,saudi arabia,ksa,riyadh,jeddah,dammam,khobar,jordan,amman,lebanon,beirut,uae,united arab emirates,dubai,abu dhabi,sharjah,qatar,doha,kuwait,bahrain,oman,muscat,iraq,morocco,tunisia,algeria,سعودية,السعودية,الرياض,جدة,الأردن,الاردن,عمان,الإمارات,الامارات,دبي,أبوظبي,قطر,الدوحة,الكويت,البحرين

# Android app: applying. Name and phone sign the cover note; the Gmail
# account sends CVs through a Google app password, not the account's own.
APPLY_NAME=
APPLY_PHONE=
APPLY_GMAIL=
APPLY_GMAIL_APP_PASSWORD=

# Job search APIs for jobs abroad (Android app, "Job search APIs" source).
# Free keys; each API is skipped while its key is empty.
#   Adzuna:    https://developer.adzuna.com  (app id + app key)
#   Jooble:    https://jooble.org/api/about  (one key)
#   Careerjet: https://www.careerjet.com/partners/api  (API key; only answers IPs allowed in the publisher account)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=

# Where the Android app's Log screen "Send" button posts the log file.
# Blank: the jobs chat above (TELEGRAM_CHAT_ID). Set it to your own chat id to keep logs out of the channel.
TELEGRAM_LOG_CHAT_ID=

# Android app: the group topic each region's jobs are posted to (Egypt, Saudi
# & UAE, Worldwide — the region every job is tagged with). A topic link (Copy
# Link on the topic), chatId:topicId, or a bare topic id inside TELEGRAM_CHAT_ID.
# Blank: that region posts to TELEGRAM_CHAT_ID. The bot must be a member of the
# group allowed to post in topics, or Telegram rejects the message.
TELEGRAM_TOPIC_EGYPT=
TELEGRAM_TOPIC_GULF=
TELEGRAM_TOPIC_WORLDWIDE=
TELEGRAM_TOPIC_FREELANCE=

# --- Ported from the Android app (Node reads all of these; blank = code default) ---
# Saudi Arabia and the UAE on Workable, Tanqeeb, Wuzzuf, Recruitera, Dr.Job and the
# company boards (default true). Such jobs are posted like Egypt's, tagged #Gulf, and
# must say they take someone relocating.
BOARDS_GULF=
# Jobs abroad: only CV fits of at least ABROAD_MIN_SCORE (55) are posted, the best
# ABROAD_MAX_PER_RUN (10) a run.
ABROAD_MIN_SCORE=
ABROAD_MAX_PER_RUN=
# Digest mode (default false): jobs scoring DIGEST_THRESHOLD (70) or more go out at
# once; the rest arrive as one message every DIGEST_EVERY_HOURS (3).
DIGEST_ENABLED=
DIGEST_THRESHOLD=
# Friday's summary of the week, after 10:00 Cairo (default true).
WEEKLY_SUMMARY_ENABLED=
# Drop jobs asking for more years than this (default 0: off).
FILTER_MAX_YEARS=
# Companies' own careers sites, separated by ";;": id|Company|sitemap URL|job URL regex
CAREER_SITES=
