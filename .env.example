# Copy to .env and fill in. Nothing here reaches the network until
# CRAWLER_ENABLED and TELEGRAM_ENABLED are both true.

# --- Master switch ----------------------------------------------------------
CRAWLER_ENABLED=false

# --- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, add it to your channel as an administrator,
# then set CHAT_ID to the channel id (e.g. -1001234567890) or @channelusername.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Operational alerts (out of Serper credits, daily cap reached, low balance),
# at most one a day per kind. Sent to TELEGRAM_CHAT_ID unless this names
# another chat, e.g. a private chat with the bot. ALERTS_ENABLED=false: none.
TELEGRAM_ALERT_CHAT_ID=
ALERTS_ENABLED=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=15000
# Telegram allows roughly 20 messages/minute to one channel.
TELEGRAM_SEND_DELAY_MS=4000

# Android app: the group topic each region's jobs are posted to (Egypt, Saudi
# & UAE, Worldwide, Freelance — the region every job is tagged with; Freelance
# is the Mostaql/Khamsat gigs). A topic link (Copy
# Link on the topic), chatId:topicId, or a bare topic id inside TELEGRAM_CHAT_ID.
# Blank: that region posts to TELEGRAM_CHAT_ID. The bot must be a member of the
# group allowed to post in topics, or Telegram rejects the message.
TELEGRAM_TOPIC_EGYPT=
TELEGRAM_TOPIC_GULF=
TELEGRAM_TOPIC_WORLDWIDE=
TELEGRAM_TOPIC_FREELANCE=
# Bot commands (/posts, /jobs, /run <source>) that run a source now. Container
# only: the crawl loop picks the requests up. Message the bot once to learn
# your user id, then list it here (comma-separated).
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_COMMAND_USER_IDS=

# --- What to look for -------------------------------------------------------
# Comma-separated. Requests per run = keywords x locations x pages, so keep
# both lists short: every extra combination is another hit on a rate-limited
# public endpoint.
#
# JOB_LOCATIONS is searched with NO work-type filter, so it returns on-site,
# hybrid and remote postings alike: Egypt and the Gulf.
JOB_KEYWORDS=Laravel Developer,Node.js Developer,Backend Developer,PHP Developer,Full Stack Developer
JOB_LOCATIONS=Egypt,Saudi Arabia,United Arab Emirates,Qatar,Kuwait,Bahrain,Oman

# Searched for REMOTE work only (LinkedIn f_WT=2): borderless searches, whose
# results FILTER_LOCATIONS places by reading the posting. No foreign country is
# named here — a US or EU "remote" posting is remote inside that country and
# screens out anyone without the right to work there. A search that names a
# market (JOB_LOCATIONS) settles where its results are, so FILTER_LOCATIONS is
# not consulted for those. Every entry is another keyword x market crawl.
# Empty disables it.
JOB_REMOTE_LOCATIONS=Worldwide,EMEA
# f_WT: 1 on-site, 2 remote, 3 hybrid.
LINKEDIN_REMOTE_WORK_TYPE=2
# Remote markets page less deeply than local ones: they multiply fastest, and
# one rate-limited endpoint serves them all.
LINKEDIN_REMOTE_MAX_PAGES=2

# --- LinkedIn source --------------------------------------------------------
LINKEDIN_JOBS_ENABLED=true
# Own schedule in --watch: every 15 minutes. In the container the same rhythm
# comes from CRAWL_SOURCES=linkedin_jobs and CRAWL_INTERVAL_MINUTES=15.
LINKEDIN_JOBS_CRON=*/15 * * * *
# f_TPR value. r3600 = posted in the last hour: wider than the 15-minute
# schedule, so a slow or missed pass loses nothing; dedup drops repeats.
LINKEDIN_TIME_WINDOW=r3600
LINKEDIN_MAX_PAGES=4

# Location rotation: each run searches ONE location of JOB_LOCATIONS (with every
# keyword), the next run the next one. With the 6 default locations (Egypt,
# Cairo, Giza, Maadi, Heliopolis, Obour) and a 10-minute interval, every location
# is searched once an hour, and each run makes 7 searches instead of 42.
# JOB_LOCATIONS cannot hold "Cairo, Egypt" (it splits on commas): change the
# list in src/config.js. Adding locations makes the cycle longer, not any run
# heavier, so it does not bring the 429s back.
#
# Time window: a location is searched once per cycle, so LINKEDIN_TIME_WINDOW
# must reach back a whole cycle. You do NOT have to change it by hand: when
# there are more than 5 locations, the window is raised automatically to
# (locations + 1) x the interval, e.g. 6 locations -> r4200 (70 min),
# 10 -> r6600 (110 min). The value above stays the minimum. The window in use
# is logged as "LinkedIn location rotation".
#
# Trade-off: a new job can take up to one full cycle to arrive (30 min with 3
# locations, 1 h with 6, 2 h with 12).
#
# The rotation is skipped (every location searched) for --location / --keyword
# runs, the --watch startup pass and bot /jobs requests.
LINKEDIN_ROTATE_LOCATIONS=false
# Minutes between runs, which the window above is computed from. Empty uses
# CRAWL_INTERVAL_MINUTES (10 in the Dockerfile); set it to match
# LINKEDIN_JOBS_CRON when running --watch.
LINKEDIN_ROTATE_INTERVAL_MINUTES=


# --- Wuzzuf source ----------------------------------------------------------
# Read through wuzzuf.net's sitemap. Its search pages are behind Cloudflare and
# answer 403 to anything that is not a browser; the sitemap and the job pages
# are open, and robots.txt allows both.
# Egypt and Saudi Arabia listings; each job is placed by the sitemap it is in.
WUZZUF_ENABLED=true
# The sitemap lists every live job (5,000+) with no usable date, so the slug is
# what decides whether a page is worth opening. URL fragments, not words:
# "node" appears there as "nodejs" or "node-js".
WUZZUF_SLUG_TERMS=
# Pages opened per run, after the slug filter and the already-seen check.
# Each page is ~0.5 MB; 10 keeps a solo run near 80 MB of RSS. A backlog is
# worked through across runs, so a low cap costs time, not coverage.
WUZZUF_MAX_DETAILS=10
# Wuzzuf states an age ("3 days ago"), not a date. Older postings are dropped.
WUZZUF_MAX_AGE_DAYS=7
# Its job pages are 500-670 KB, so they need longer than HTTP_TIMEOUT_MS.
WUZZUF_TIMEOUT_MS=30000

# --- Tanqeeb source ---------------------------------------------------------
# An aggregator: its cards name the board each posting is really on — LinkedIn,
# Bayt, Wuzzuf, Naukri Gulf. This is the only route to Bayt's listings, since
# bayt.com answers 403 to every non-browser request.
# Expect heavy overlap with the LinkedIn source; the store's fingerprint check
# (company + title, across sources) is what stops a job being sent twice.
# One site per country, so its results need no location guessing. Searched:
# the subdomains in TANQEEB_SITES, from egypt,saudi,uae,qatar,kuwait,bahrain,
# oman (all by default). Each one is another page per keyword per run.
TANQEEB_ENABLED=true
TANQEEB_SITES=egypt,saudi,uae,qatar,kuwait,bahrain,oman
# Or search a single URL instead, as the market named here.
TANQEEB_SEARCH_URL=
TANQEEB_MARKET=Egypt
# A search page is ~450 KB. Page 2 added nothing measurable and ~20 MB.
TANQEEB_MAX_PAGES=1
TANQEEB_MAX_AGE_DAYS=7

# --- Naukrigulf source ------------------------------------------------------
# Read through the JSON endpoint its own pages call: naukrigulf.com itself is a
# script shell with no job markup in it. One response carries the employer, the
# description and a posted date, so nothing is opened per posting — this is the
# cheapest source here, one request per keyword.
# Searches name no country on purpose; FILTER_LOCATIONS decides what survives.
NAUKRIGULF_ENABLED=true
NAUKRIGULF_SEARCH_URL=
# The ids the site's own front-end sends. Not credentials — without them the
# endpoint answers 404. Here so a change on their side is an env edit.
NAUKRIGULF_APP_ID=205
NAUKRIGULF_SYSTEM_ID=2323
# Results come back newest-first, so one page per keyword is normally all that
# is new since the last pass. 50 is the largest page the endpoint honours.
NAUKRIGULF_PAGE_SIZE=50
NAUKRIGULF_MAX_PAGES=1
NAUKRIGULF_MAX_AGE_DAYS=7
NAUKRIGULF_TIMEOUT_MS=15000

# --- Recruitera source ------------------------------------------------------
# The ATS behind ~80 employers' career pages (Paymob, Fawry, Banque Misr,
# ElSewedy…), read through the public JSON API those pages call. Companies come
# from app.recruitera.ai/sitemap.xml, so new employers are picked up on their
# own. Keeps jobs in a tech category whose own country is in the list — local
# hiring, so on-site and hybrid roles are kept (RECRUITERA_REMOTE_ONLY).
# In the container it runs on every start and then every 6 hours, and a run
# the network cuts short is retried on the next pass (Telegram alert after
# CRAWL_NOTIFY_AFTER_FAILURES failures in a row): see
# CRAWL_PERIODIC_SOURCES=recruitera:6 and CRAWL_RUN_AT_START=recruitera.
# Seniority rules still come from FILTER_SENIORITY_*.
RECRUITERA_ENABLED=true
# Recruitera's own category names, comma-separated.
RECRUITERA_CATEGORIES=IT/Software Development,Engineering - Telecom/Technology
# ISO country codes read off each job, not the company's home country.
RECRUITERA_COUNTRIES=EG,SA,AE,QA,KW,BH,OM
# Narrow tech roles by title, e.g. laravel,php,backend,node. Empty keeps all.
RECRUITERA_FILTER_TITLE=
RECRUITERA_REMOTE_ONLY=false
# Career-site slugs the sitemap misses (app.recruitera.ai/careers/<slug>).
RECRUITERA_EXTRA_SITES=
# Slugs never crawled. Slugs starting "test" are always skipped, and generated
# QA titles ("Legacy Data Agent mun6kji05zs") are dropped on every site.
RECRUITERA_EXCLUDE_SITES=recutira
# Job pages opened per run; the rest wait for the next run.
RECRUITERA_MAX_DETAILS=60
# Days. A job dated older than this is dropped; one with no date is still sent.
RECRUITERA_MAX_AGE_DAYS=7
RECRUITERA_MAX_PAGES=5
RECRUITERA_TIMEOUT_MS=15000

# --- Workable source --------------------------------------------------------
# jobs.workable.com, the cross-company board of every Workable customer
# (Robusta, Lucidya, Nawy, Salla…), read through the JSON endpoint its search
# page calls. One request per keyword x location page; the shared FILTER_*
# rules decide what is sent. Hourly in the container (CRAWL_PERIODIC_SOURCES=workable:1).
WORKABLE_ENABLED=true
# Empty uses JOB_KEYWORDS / JOB_LOCATIONS.
WORKABLE_KEYWORDS=
WORKABLE_LOCATIONS=
# Sent as day_range: Workable only returns jobs this many days old or newer.
WORKABLE_MAX_AGE_DAYS=7
# 20 jobs a page.
WORKABLE_MAX_PAGES=2
WORKABLE_TIMEOUT_MS=15000

# --- VerteX source ----------------------------------------------------------
# VerteX Technologies' vacancies (vertextech-eg.com/vacancies), read through the
# site's sitemap and each new vacancy's page. Nothing there is dated, so the
# first run records what is already open and sends none of it; after that only
# vacancies not listed before are sent. Hourly in the container
# (CRAWL_PERIODIC_SOURCES=vertex:1).
VERTEX_ENABLED=true
# false sends the vacancies already open on the first run too.
VERTEX_BASELINE=true
# New vacancy pages opened per run; the rest wait for the next run.
VERTEX_MAX_DETAILS=20
VERTEX_TIMEOUT_MS=15000

# --- ATS source (named company career boards) -------------------------------
# Companies whose own careers page runs on Lever, Greenhouse, Ashby, BambooHR,
# Recruitee, Teamtailor, SuccessFactors, Breezy or Zoho Recruit, read through
# each platform's public feed. One request per company; the shared FILTER_*
# rules decide what is sent. Twice a day in the container (CRAWL_PERIODIC_SOURCES=ats:12).
ATS_ENABLED=true
# platform:slug[:Company name], from the board's address:
#   jobs.lever.co/klivvr -> lever:klivvr
#   boards.greenhouse.io/tamara -> greenhouse:tamara
#   jobs.ashbyhq.com/thndr -> ashby:thndr
#   instabug.bamboohr.com -> bamboohr:instabug
#   elmenus.recruitee.com -> recruitee:elmenus
#   propertyfinder.teamtailor.com -> teamtailor:propertyfinder
#   careers.axisapp.com (Teamtailor) -> teamtailor:careers.axisapp.com
#   almentor.breezy.hr -> breezy:almentor
#   qutip.zohorecruit.com -> zoho:qutip
#   zohomea.zohorecruit.in -> zoho:zohomea.zohorecruit.in
#   career5.successfactors.eu/careers?company=capgemitecP3
#     -> successfactors:career5.successfactors.eu/capgemitecP3
# A SuccessFactors listing is the company's whole world and names no place;
# /unitId/Place keeps one hiring unit's jobs and says where it is
# (capgemitecP3/15638549/Egypt is Capgemini Egypt).
# Workable boards are left out: the workable source already covers them.
ATS_BOARDS=lever:klivvr:Klivvr,ashby:thndr:Thndr,greenhouse:tamara,bamboohr:instabug:Instabug,bamboohr:bosta:Bosta,recruitee:elmenus,teamtailor:careers.axisapp.com:Axis,teamtailor:propertyfinder:Property Finder,teamtailor:supersub:Supersub,teamtailor:convertedin:Convertedin,teamtailor:dubizzle:Dubizzle,successfactors:career5.successfactors.eu/capgemitecP3/15638549/Egypt:Capgemini,lever:Yassir:Yassir,lever:aleph:Aleph,ashby:hirehangar:Hire Hangar,ashby:talentsafari:Talent Safari,greenhouse:agoda,greenhouse:decimainternational,greenhouse:wppmedia,teamtailor:issinternational:ISS International,breezy:almentor,breezy:digisay,breezy:manara,breezy:takwene,breezy:ontrac-solutions-llc,breezy:plat4mation,zoho:careers.migrationit.com:MigrationIT,zoho:fixedmea:Fixed Solutions,zoho:fawrymicrofinance:FawryMSME Finance,zoho:leadintop:LeadInTop,zoho:qutip:QuTip,zoho:snap-14:SNAP14 Production,zoho:zohomea.zohorecruit.in:Zoho MEA,zoho:coorb:CoorB,zoho:gotocme:CME,zoho:centrocdx:Centro CDX,zoho:dotit:Dot IT,zoho:sajoom:Impact Sustainability,zoho:seenapay:Seena Pay,zoho:vxlabs.zohorecruit.eu:VxLabs,zoho:garageilla:Garage ILLA,zoho:nacita:Nacita,zoho:proven-sa:Proven Arabia,zoho:luckyegypt:Lucky,greenhouse:canonical:Canonical,ashby:constructor:Constructor,greenhouse:automatticcareers:Automattic,greenhouse:xapo61:Xapo Bank
# Days. Older is dropped; BambooHR dates nothing and most Zoho boards hide the
# date, so those jobs are always kept and dedup sends each once.
ATS_MAX_AGE_DAYS=14
# Per-board cutoffs that override ATS_MAX_AGE_DAYS, platform:slug:days.
# A board dated only by day (Zoho's Date_Opened) counts whole days: 3 keeps
# everything opened today and the three days before.
ATS_BOARD_MAX_AGE_DAYS=zoho:careers.migrationit.com:3
# Per request; the SuccessFactors listing is 15 MB and takes 20-40 seconds.
ATS_TIMEOUT_MS=90000

# --- AI data source (labelling / annotation / assessment) -------------------
# Annotation, transcription, AI trainer / rater / evaluator and linguist work
# on audio, images, video and text, Arabic especially. Searched on
# jobs.workable.com with these keywords, plus any vendor boards below. The
# title decides what is sent (AI_DATA_FILTER_TITLE), not FILTER_TECH. Every 3
# hours in the container (CRAWL_PERIODIC_SOURCES=ai_data:3).
AI_DATA_ENABLED=true
# Empty = the code defaults (Data Annotation, Arabic Annotator, Audio
# Annotation, Image Annotation, Image Labeling, Transcription, AI Trainer, Arabic AI Trainer,
# Arabic Linguist, AI Rater). Each keyword x location is one request.
AI_DATA_KEYWORDS=
# "Anywhere" searches with no location; what it returns is kept only if remote.
AI_DATA_LOCATIONS=Egypt,Anywhere
# Vendor career boards, platform:slug[:Name] as in ATS_BOARDS, e.g.
#   lever:toloka:Toloka,greenhouse:welocalize:Welocalize
# A wrong slug only logs "AI data board returned no feed" and is skipped.
AI_DATA_BOARDS=
# Where an on-site job may be. Empty = Egypt and its cities; remote is kept anywhere.
AI_DATA_PLACES=
# Empty = the code defaults: annotation, annotator, data labeling, transcription,
# ai trainer, rater, evaluator, linguist, language expert, ... and Arabic ones.
AI_DATA_FILTER_TITLE=
# Generalist work only: a title naming a field that needs a degree is dropped.
# Empty = the code defaults: medical, nurse, pharmacist, legal, finance,
# accounting, math, physics, civil / mechanical / electrical engineering, ...
# and their Arabic forms. Software / coding gigs and plain image labelling stay.
AI_DATA_FILTER_TITLE_EXCLUDE=
# Arabic, or Arabic + English: an ad naming one of AI_DATA_OTHER_LANGUAGES is
# dropped unless it also names one of AI_DATA_LANGUAGES. An ad naming no
# language is kept. Empty = the code defaults (Arabic spellings; French,
# German, Spanish, Japanese, ... ). English is in neither list on purpose.
AI_DATA_LANGUAGES=
AI_DATA_OTHER_LANGUAGES=
AI_DATA_REMOTE_ONLY=false
AI_DATA_MAX_PAGES=1
AI_DATA_MAX_AGE_DAYS=7
AI_DATA_DELAY_MS=2000
AI_DATA_TIMEOUT_MS=20000

# --- HTTP behaviour ---------------------------------------------------------
HTTP_TIMEOUT_MS=15000
# Applied before every request, including the first.
REQUEST_DELAY_MS=2500
MAX_RETRIES=3
# Exponential: base * 2^(attempt-1) -> 4s, 8s, 16s
BACKOFF_BASE_MS=4000
USER_AGENT=

# --- Run limits -------------------------------------------------------------
MAX_ITEMS_PER_RUN=100
RETRY_AFTER_MINUTES=30
MAX_SEND_ATTEMPTS=5

# --- Schedule ---------------------------------------------------------------
# Standard 5-field cron. Used by `npm start` (--watch).
CRON_SCHEDULE=0 * * * *
TZ=Africa/Cairo

# --- Storage / logging ------------------------------------------------------
DATABASE_PATH=./data/crawler.sqlite
LOG_LEVEL=info
LOG_FILE=./logs/crawler.log
# Decision log (database table `decisions`): every rejected / duplicate / accepted
# item and why. View with `node src/index.js --rejected`, GET /decisions, or /rejected.
LOG_DECISIONS=true
LOG_DECISIONS_ACCEPTED=true
DECISIONS_RETENTION_DAYS=14

# --- Filtering (applied to every source: jobs now, posts later) -------------
FILTER_ENABLED=true
# Item must contain at least one of these.
FILTER_TECH=laravel,node,nodejs,node.js,php,backend,back-end,back end
# ...and at least one of these.
FILTER_LOCATIONS=worldwide,anywhere,work from anywhere,emea,mena,middle east,gcc,egypt,cairo,giza,alexandria,saudi arabia,ksa,riyadh,jeddah,dammam,khobar,uae,united arab emirates,dubai,abu dhabi,sharjah,qatar,doha,kuwait,bahrain,manama,oman,muscat
# Off: on-site and hybrid jobs in Egypt and the Gulf are wanted too. LinkedIn
# still asks for remote only on the borderless JOB_REMOTE_LOCATIONS searches.
# true drops anything that does not say remote.
FILTER_REMOTE_ONLY=false
# Hiring posts only, never job-seeking ones. Applies to items of type 'post'
# and is inert for a job board's listing, which is an advertisement by
# definition. Decided on grammatical voice - an employer writes "we are
# looking for", a seeker writes "I am looking for" - plus an outright reject
# on the #OpenToWork and #OpenForWork hashtags.
FILTER_HIRING_ONLY=true
# true also drops a post whose snippet said neither way. Off by default: a
# snippet cut short mid-sentence is the usual cause, and the post behind it is
# often a real vacancy.
FILTER_HIRING_STRICT=false
# Wanted levels.
FILTER_SENIORITY_INCLUDE=junior,jr,mid,mid-level,midlevel,mid level,intermediate,entry level,entry-level
# Rejected outright, even if a wanted level also appears.
FILTER_SENIORITY_EXCLUDE=senior,sr,lead,principal,staff,staff engineer,founding,head of,director,manager,architect,vp,chief,expert
# false = keep items that never state a level. true = only explicit junior/mid.
FILTER_SENIORITY_STRICT=false
# The job title must name one of these: the stack, backend, full stack, or a
# generic software/web role (FILTER_TECH still checks the stack). Empty disables the rule.
FILTER_TITLE=laravel,php,symfony,codeigniter,backend,back-end,back end,server side,server-side,node,nodejs,node.js,nestjs,express,expressjs,full stack,full-stack,fullstack,mern,mean stack,software engineer,software developer,web developer,web engineer,application developer,api developer,api engineer
# Never wanted. Matched against the title and the posting's own location only.
FILTER_BLOCKED_LOCATIONS=india,bengaluru,bangalore,hyderabad,mumbai,pune,chennai,delhi,noida,gurugram,gurgaon,kolkata,pakistan,karachi,lahore,islamabad,rawalpindi,nigeria,lagos,abuja
# Rejected when the posting says any of these anywhere: residency, work
# authorisation, citizenship, clearance, nationality quotas, co-founder roles.
FILTER_INELIGIBLE=authorized to work in,authorised to work in,legally authorized,legally authorised,work authorization,work authorisation,eligible to work in,right to work in,must be based in,must reside in,must be located in,must live in,must be a resident,no visa sponsorship,unable to sponsor,not able to sponsor,will not sponsor,cannot sponsor,without sponsorship,us citizen,u.s. citizen,us citizenship,u.s. citizenship,green card,security clearance,clearance required,saudi national,saudi nationals,uae national,uae nationals,emirati,qatari national,qatari nationals,co-founder,cofounder
# Require a contact in the item: all = only keep postings containing an email or
# phone number; none = keep everything that passed the other filters.
FILTER_REQUIRE_CONTACT=none

# LinkedIn server-side experience filter (f_E). Default 1,2,3,4 — mid-senior
# is in because a 2-4 year role is often tagged 4, and whatever this drops
# never reaches your own seniority rules.
# 1 internship, 2 entry, 3 associate, 4 mid-senior, 5 director. Empty = off.
LINKEDIN_EXPERIENCE_LEVELS=2,3

# Set by the hosting platform; when present, --watch serves the status page
# and POST /run. --serve defaults to 3000 when this is unset.
PORT=

# Required for POST /run from anywhere but localhost. A crawl posts to your
# Telegram channel, so an exposed port without a token would let anyone
# trigger one: with API_TOKEN unset, remote callers are refused instead.
# Send it as "Authorization: Bearer <token>".
API_TOKEN=

# Window used only by the crawl that runs at startup. Wider than the hourly
# ticks so a restart or any downtime still catches recent jobs. Dedup keeps
# anything already delivered from being sent twice.
LINKEDIN_STARTUP_TIME_WINDOW=r86400

# --- LinkedIn posts source (hiring posts, via a search index) ----------------
# Logged-out LinkedIn has no post search, so this source asks a search engine
# for public post permalinks and then reads each post. No LinkedIn account and
# no cookie - but the default engine is a paid API, because the free ones do
# not answer a datacentre address.
#
# This source deliberately targets something different from the job sources:
# local hiring posts in one market, not remote work abroad. It has its own
# keywords, its own locations, its own schedule and its own filters.
LINKEDIN_POSTS_ENABLED=

# serper (recommended), searxng or duckduckgo.
#   serper      - Google's index as a JSON API. ~$1 per 1,000 queries, 2,500
#                 free credits to start. The only one that works from a cloud
#                 host. Needs SERPER_API_KEY below.
#   searxng     - the instance in docker-compose.yml. Free, but it has to run
#                 beside the crawler, and needs two edits to the settings.yml
#                 it writes on first boot:
#                   search.formats: [html, json]
#                   server.limiter: false
#   duckduckgo  - nothing to install, but it serves an "anomaly" page instead
#                 of results to most non-browser addresses.
LINKEDIN_POSTS_ENGINE=

# --- serper -----------------------------------------------------------------
# From https://serper.dev. Treat it as a secret: there is no per-key spend cap
# beyond the credit pack, so a leaked key drains the balance.
SERPER_API_KEY=
SERPER_URL=
# Billed queries a day across linkedin_posts and x_posts, counted in TZ. A
# source that reaches it stops, delivers what it found, and sends one alert.
# Default 100; 0 = no cap.
SERPER_DAILY_CAP=
# Pause between Serper requests, ms (default 1000). Its own, not
# REQUEST_DELAY_MS: that one is tuned for LinkedIn's guest pages.
SERPER_DELAY_MS=
# Alert when fewer credits than this are left, read once a run from Serper's
# account endpoint (no credit spent). Default 300; 0 = off.
SERPER_LOW_BALANCE=
SERPER_ACCOUNT_URL=
# Google country code - this is what actually scopes results to a market; the
# location term in the query only biases them. eg, sa, ae, gb, us.
LINKEDIN_POSTS_COUNTRY=

# --- searxng ----------------------------------------------------------------
# As the crawler sees it: http://searxng:8080 under compose, http://localhost:8080 outside.
SEARXNG_URL=
# Any long random string, used by the SearXNG container in docker-compose.yml.
SEARXNG_SECRET=

# --- targeting --------------------------------------------------------------
# This source's own lists, NOT JOB_KEYWORDS / JOB_LOCATIONS. Every
# keyword x location pair is one paid query per page, per run - so one keyword
# and one location is 1 query a day, about 30 a month.
# Default: Backend,Full Stack,Software Engineer. Google matches "Full Stack"
# and "full-stack" alike.
LINKEDIN_POSTS_KEYWORDS=
# Extra tech words a post may match on, beyond FILTER_TECH. Posts only.
LINKEDIN_POSTS_EXTRA_TECH=full stack,full-stack,fullstack,software engineer,software engineers
# Default: Egypt,Cairo,New Cairo,Giza,Maadi,Dokki,Nasr City,Heliopolis,
# Sheikh Zayed,6th of October,Fifth Settlement - posts often name the area,
# not the country. 3 keywords x 11 locations = 33 queries per run in pairs
# mode, 6 in grouped mode (below).
LINKEDIN_POSTS_LOCATIONS=
# Its own schedule, because a search index updates daily and this source is
# billed per query. Empty falls back to CRON_SCHEDULE, which is hourly and
# would cost 24x more for the same posts. Read in TZ, not the host clock.
# Default: 30 3 * * * (03:30 daily).
LINKEDIN_POSTS_CRON=

# Result language: en, ar, all.
LINKEDIN_POSTS_LANGUAGE=
# {keyword} and {location} are substituted from the two lists above.
# Serper passes Google's operators through, so OR groups and -"negative terms"
# work here and do real filtering before a credit is spent.
LINKEDIN_POSTS_QUERY=
# pairs (default): one query per keyword x location.
# grouped: up to GROUP_SIZE locations in one query as an OR group, so
#   "{location}" becomes ("Egypt" OR "Cairo" OR ...). 33 queries -> 6.
#   Compare the two with `node src/index.js --stats` (each query's hits).
LINKEDIN_POSTS_QUERY_MODE=
LINKEDIN_POSTS_GROUP_SIZE=
# A query that found no fresh post on COLD_AFTER runs in a row (default 5) is
# asked every COLD_EVERY_DAYS days (default 3) until it finds one. 0 = off.
LINKEDIN_POSTS_COLD_AFTER=
LINKEDIN_POSTS_COLD_EVERY_DAYS=
# Engine search window: d (past day), w (week), m (month), empty (any age).
# Kept at a week for recall; freshness is enforced by MAX_AGE_DAYS below, which
# reads each post's real date, so this need not be tight.
LINKEDIN_POSTS_TIME_WINDOW=
# Window used only by the crawl that runs at startup.
LINKEDIN_POSTS_STARTUP_TIME_WINDOW=
# DuckDuckGo region bias, e.g. eg-en, xa-ar, us-en. Ignored by serper and SearXNG.
LINKEDIN_POSTS_REGION=
# Result pages per keyword x location. Each page is a billed query on serper.
LINKEDIN_POSTS_MAX_PAGES=
# The real freshness cut, in days (default 3). Exact, not a guess: the activity
# id in every permalink encodes when the post was written, so age is read from
# the post itself, not from the engine's index time. Three, not one, because
# Google indexes a post 2-3 days after it is written, so a tighter cut on this
# search-index route is empty almost always.
LINKEDIN_POSTS_MAX_AGE_DAYS=
# Fetch each post permalink to replace the search snippet with the full body.
# Free - these requests go to LinkedIn, not to the search API.
LINKEDIN_POSTS_FETCH_DETAILS=
# Cap on those per-post requests per run.
LINKEDIN_POSTS_MAX_DETAILS=
# Require the post to be remote. Off for this source: it targets a local
# market, where an on-site hiring post is exactly what is wanted.
LINKEDIN_POSTS_REMOTE_ONLY=
# Reposts: the same ad under a new link (repost, reshare, another recruiter)
# is dropped when this share of its words matches a post from the last
# LINKEDIN_POSTS_DEDUP_DAYS days. Lower catches more, and risks swallowing a
# different ad that reads alike. 0 days turns it off. Defaults: 30, 0.8.
LINKEDIN_POSTS_DEDUP_DAYS=
LINKEDIN_POSTS_DEDUP_THRESHOLD=
# Hiring-vs-seeking, for this source specifically. Its own variables, not the
# FILTER_HIRING_* pair: strict is ON here and off crawl-wide, and sharing one
# switch would let the global setting silently disable it.
#   HIRING_ONLY   - drop posts written by people looking for work
#   HIRING_STRICT - also drop posts that said neither way. On, because a
#                   "site:linkedin.com/posts laravel" search returns as much
#                   Laravel *content* as Laravel hiring, and all of it passes
#                   the tech filter.
LINKEDIN_POSTS_HIRING_ONLY=true
LINKEDIN_POSTS_HIRING_STRICT=true
# Markets that are not this one. A post naming no market is kept on the
# strength of the search; a post naming one of these is not.
LINKEDIN_POSTS_EXCLUDE_LOCATIONS=saudi,saudi arabia,ksa,riyadh,jeddah,dammam,khobar,jordan,amman,lebanon,beirut,uae,united arab emirates,dubai,abu dhabi,sharjah,qatar,doha,kuwait,bahrain,oman,muscat,iraq,morocco,tunisia,algeria,سعودية,السعودية,الرياض,جدة,الأردن,الاردن,عمان,الإمارات,الامارات,دبي,أبوظبي,قطر,الدوحة,الكويت,البحرين

# --- X posts source (hiring posts on X, via a search index) -----------------
# The LinkedIn posts approach pointed at x.com: Serper finds /status/ links and
# the search snippet is what the filters read (X shows logged-out clients
# nothing, so the post itself cannot be opened). Uses SERPER_API_KEY above and
# the LinkedIn posts keywords, locations and filters unless given its own.
# OFF: every keyword x location pair is another paid query.
X_POSTS_ENABLED=false
X_POSTS_KEYWORDS=
X_POSTS_LOCATIONS=
# As the LINKEDIN_POSTS_ ones above.
X_POSTS_QUERY_MODE=
X_POSTS_GROUP_SIZE=
X_POSTS_COLD_AFTER=
X_POSTS_COLD_EVERY_DAYS=
X_POSTS_CRON=
X_POSTS_QUERY=
# Engine search window (d/w/m); kept at a week for recall. Freshness is the cut
# below, read from each post's own date.
X_POSTS_TIME_WINDOW=
# Freshness cut in days (default 3): the status id encodes the post's time.
# Three, not one, because Google indexes an X post 2-3 days late — a 1-day cut
# on this route is empty. The x_session source below is the truly same-day one.
X_POSTS_MAX_AGE_DAYS=
X_POSTS_MAX_PAGES=

# --- X session source (hiring posts on X, signed in by cookie) --------------
# X's own search, called as its web app calls it. Free, full text, fresh — and
# against X's terms of service. USE A THROWAWAY ACCOUNT: X locks accounts it
# thinks are automated.
#
# SECURITY: auth_token is full control of that account — posting, DMs,
# settings, and it gets past 2FA. Set X_AUTH_TOKEN and X_CT0 in the host's
# secret settings or your shell, NEVER in a committed file. (.env is tracked by
# git in this repository.)
#
# Getting them: log in to the throwaway account at x.com, open DevTools →
# Application → Cookies → https://x.com, copy `auth_token` and `ct0`. They last
# until X logs the session out; the run reports "X rejected the session" then.
# The source stays off until both are set.
X_SESSION_ENABLED=false
X_AUTH_TOKEN=
X_CT0=
X_SESSION_KEYWORDS=
X_SESSION_LOCATIONS=
# Every 6 hours. In the container, list it in CRAWL_PERIODIC_SOURCES instead.
X_SESSION_CRON=
# X search syntax; {keyword} and {location} are filled in, since: is appended.
X_SESSION_QUERY=
# Days back to search, via since: (default 1). since: is date-granular, so
# MAX_AGE_DAYS below is the exact cut.
X_SESSION_TIME_WINDOW_DAYS=
X_SESSION_STARTUP_TIME_WINDOW_DAYS=
# Freshness cut in days (default 1), read from each post's created_at or id.
X_SESSION_MAX_AGE_DAYS=
X_SESSION_MAX_PAGES=
# Hard ceiling per run. X allows ~50 searches per 15 minutes per account.
X_SESSION_MAX_REQUESTS=
# Pause before each request, in ms (default 8000).
X_SESSION_DELAY_MS=
# X rotates these. When a run says the query id was rotated, copy the current
# one from DevTools → Network on x.com/search (the SearchTimeline request).
X_SEARCH_QUERY_ID=
# JSON object; empty uses the built-in set. Needed when X answers
# "The following features cannot be null".
X_SESSION_FEATURES=
