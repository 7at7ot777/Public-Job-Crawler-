<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="96dp">

        <!-- Something that needs the person: no Telegram, backup off. -->
        <LinearLayout
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/banner"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/bannerIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="1dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_warning" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/bannerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.15"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/bannerAction"
                    style="@style/FilterChip"
                    android:layout_marginStart="-14dp"
                    android:background="@android:color/transparent"
                    android:text="Open settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- The console: whether it runs, when it last ran, what is waiting. Dark in both modes. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hero"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot" />

                <TextView
                    android:id="@+id/statusLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/plex_mono_medium"
                    android:letterSpacing="0.04"
                    android:textAllCaps="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/manrope_extrabold"
                android:letterSpacing="-0.02"
                android:textColor="@color/heroText"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/subline"
                style="@style/Caption"
                android:layout_marginTop="4dp"
                android:textColor="@color/heroMuted"
                android:textSize="14sp" />

            <!-- A run handed over by an outage: nothing to tap, it resumes by itself. -->
            <LinearLayout
                android:id="@+id/offlineNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/hero_note"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginTop="1dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wifi_off"
                    android:tint="@color/heroWarn" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.15"
                    android:text="No network. Found jobs are kept; unsent ones wait for Telegram. Nothing to tap: the run picks up by itself."
                    android:textColor="@color/heroText"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Three counts, each a way in: new jobs, emails to review, CVs sent on their own. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/statNewTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/hero_tile"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/statNew"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plex_mono_medium"
                        android:text="0"
                        android:textColor="@color/heroText"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="new jobs"
                        android:textColor="@color/heroMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statReviewTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/hero_tile"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/statReview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plex_mono_medium"
                        android:text="0"
                        android:textColor="@color/heroText"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="to review"
                        android:textColor="@color/heroMuted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/statGulfTile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/hero_tile"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <TextView
                        android:id="@+id/statGulf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plex_mono_medium"
                        android:text="0"
                        android:textColor="@color/heroGulf"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/manrope_semibold"
                        android:text="sent today · Gulf"
                        android:textColor="@color/heroMuted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/runNow"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_hero"
                    android:drawablePadding="8dp"
                    android:text="Run now"
                    android:textColor="@color/heroOnAccent" />

                <Button
                    android:id="@+id/pause"
                    style="@style/ButtonPrimary"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_hero_outline"
                    android:drawablePadding="8dp"
                    android:text="Pause"
                    android:textColor="@color/heroText" />
            </LinearLayout>
        </LinearLayout>

        <!-- Egypt: posted to Telegram. -->
        <LinearLayout style="@style/Card" android:layout_marginTop="14dp" android:paddingBottom="6dp" android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/egyptHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_semibold"
                    android:text="Posted to Telegram"
                    android:textColor="@color/textMuted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plex_mono"
                    android:text="found · new"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sourceRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Saudi & UAE: the CV is emailed on its own, nothing is posted. -->
        <LinearLayout
            android:id="@+id/gulfCard"
            style="@style/Card"
            android:layout_marginTop="14dp"
            android:paddingBottom="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/gulfHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_semibold"
                    android:text="Emailed, never posted"
                    android:textColor="@color/textMuted"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plex_mono"
                    android:text="found · new"
                    android:textColor="@color/textMuted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/gulfRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- The paid search: today's searches against the daily cap. -->
        <LinearLayout
            android:id="@+id/serperCard"
            style="@style/Card"
            android:layout_marginTop="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/CardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Serper searches"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/serperToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plex_mono_medium"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/serperBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progressBackgroundTint="@color/track"
                android:progressTint="@color/primary" />

            <TextView android:id="@+id/serperNote" style="@style/Caption" android:layout_marginTop="10dp" android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/footer"
            style="@style/Caption"
            android:layout_marginTop="16dp"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
