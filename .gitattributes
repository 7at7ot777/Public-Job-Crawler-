# The repo is authored on Windows but everything runs on Linux in a container.
# A shell script checked out with CRLF has "#!/bin/sh\r" as its shebang, which
# the kernel reports as a missing interpreter — a confusing way to fail.
*.sh            text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.env            text eol=lf
.env.example    text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.js            text eol=lf
